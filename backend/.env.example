# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git, so your key stays on your computer.
# Never paste the real key into this example file.

QFLOW_IBM_TOKEN=paste-your-ibm-api-key-here
QFLOW_IBM_CRN=paste-your-crn-here
# Optional. Leave this line out to use the default.
# QFLOW_IBM_CHANNEL=ibm_cloud
